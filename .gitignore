# Virtual environment
.venv/

# API keys — never commit
paperbot/backend/.env

# Qdrant data (inside Docker, not needed in repo)
qdrant_storage/

# Extracted images (regenerated by ingest)
paperbot/backend/data/images/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Model weights (large files, downloaded at runtime)
*.pt
*.onnx
*.bin

# Temp files
/tmp/
*.tmp

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Frontend build output (can be rebuilt with npm run build)
paperbot/frontend/dist/
paperbot/frontend/node_modules/
other/ 
